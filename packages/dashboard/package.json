    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "env-cmd": "^10.1.0",
    "globals": "^16.0.0",
    "sass": "^1.85.1",
    "typescript": "latest",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.0"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
